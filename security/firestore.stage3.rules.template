// REVIEW DRAFT ONLY. Stage 3: owner isolation, server grading and trusted content writes.
// Deploy only with matching API/client after compatibility review; NOT deployed.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function trustedAdmin() { return signedIn() && request.auth.uid == '__TRUSTED_ADMIN_UID__'; }
    function ownRecord(data) { return signedIn() && data.get('user_id', '') == request.auth.uid; }
    function ownAttempt(id) {
      return signedIn() && id is string &&
        get(/databases/$(database)/documents/exam_attempts/$(id)).data.user_id == request.auth.uid;
    }

    function zeroProgress(data) {
      return data.get('total_points', 0) == 0 && data.get('total_xp', 0) == 0 && data.get('current_level', 1) == 1;
    }
    function unchangedProgress() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['total_points','total_xp','current_level']);
    }
    match /profiles/{userId} {
      allow read: if own(userId) || trustedAdmin();
      allow create: if trustedAdmin() || (own(userId) && request.resource.data.get('role', 'user') == 'user' && zeroProgress(request.resource.data));
      allow update: if trustedAdmin() || (own(userId) &&
        request.resource.data.get('role', 'user') == resource.data.get('role', 'user') && unchangedProgress());
      allow delete: if trustedAdmin() || own(userId);
    }
    match /users/{userId} {
      allow read: if own(userId) || trustedAdmin();
      allow create: if own(userId) && (trustedAdmin() || request.resource.data.get('isAdmin', false) == false);
      allow update: if own(userId) && (trustedAdmin() ||
        request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false));
      allow delete: if own(userId);
    }
    match /usernames/{userId} {
      // Existing pre-login lookup needs one document, never the whole directory.
      allow get: if true;
      allow list: if trustedAdmin();
      allow create: if signedIn() && request.resource.data.get('uid', '') == request.auth.uid &&
        userId.matches('^[a-z0-9_]{3,}$') && request.resource.data.get('email', '') == userId + '@knobly.id';
      allow update: if signedIn() && resource.data.get('uid', '') == request.auth.uid &&
        request.resource.data.get('uid', '') == resource.data.get('uid', '') &&
        request.resource.data.get('email', '') == resource.data.get('email', '');
      allow delete: if signedIn() && resource.data.get('uid', '') == request.auth.uid;
    }
    match /user_settings/{userId} { allow read, write: if own(userId); }

    match /exam_user_state/{id} {
      allow read: if trustedAdmin() || ownRecord(resource.data);
      // Signup may initialize exactly one zero state. All subsequent progress is server/admin-written.
      allow create: if trustedAdmin() || (own(id) && ownRecord(request.resource.data) && zeroProgress(request.resource.data) &&
        request.resource.data.keys().hasOnly(['user_id','total_xp','total_points','current_level','streak_days','created_at']) &&
        request.resource.data.get('streak_days', 0) == 0);
      allow update, delete: if trustedAdmin();
    }
    match /exam_attempts/{id} {
      allow read: if trustedAdmin() || ownRecord(resource.data);
      allow write: if trustedAdmin();
    }
    match /exam_responses/{id} {
      allow read: if trustedAdmin() || ownAttempt(resource.data.get('attempt_id', ''));
      allow write: if trustedAdmin();
    }
    match /exam_user_badges/{id} {
      allow read: if trustedAdmin() || ownRecord(resource.data);
      allow write: if trustedAdmin();
    }
    // Answer keys/active answers and award serialization are only used by the Admin SDK.
    match /exam_attempt_keys/{id} { allow read, write: if false; }
    match /exam_awards/{id} { allow read, write: if false; }
    match /exam_questions/{id} { allow read, write: if trustedAdmin(); }
    match /exam_options/{id} { allow read, write: if trustedAdmin(); }
    match /questions/{id} { allow read, write: if trustedAdmin(); }
    match /tests/{id} { allow read, write: if trustedAdmin(); }
    match /exam_proctor_log/{id} {
      allow read: if trustedAdmin() || (ownRecord(resource.data) && ownAttempt(resource.data.get('attempt_id', '')));
      allow create: if trustedAdmin() || (ownRecord(request.resource.data) && ownAttempt(request.resource.data.get('attempt_id', '')));
      allow update, delete: if trustedAdmin();
    }
    match /test_results/{id} {
      allow read: if trustedAdmin() || ownRecord(resource.data);
      allow write: if trustedAdmin();
    }
    match /{collection}/{docId} {
      allow read: if signedIn() && collection in [
        'exam_tests', 'exam_levels', 'exam_badges', 'notifications', 'apps', 'videos', 'exam_categories'
      ];
      allow write: if trustedAdmin() && collection in [
        'exam_tests', 'exam_levels', 'exam_badges', 'notifications', 'apps', 'videos', 'exam_categories'
      ];
    }
  }
}
