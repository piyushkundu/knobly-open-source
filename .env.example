# Local demo only. Never paste the original site's Firebase configuration here.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-knobly-local
NEXT_PUBLIC_FIREBASE_API_KEY=emulator-only-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_APP_ID=emulator-only-app
FIREBASE_ADMIN_PROJECT_ID=demo-knobly-local
GCLOUD_PROJECT=demo-knobly-local
METADATA_SERVER_DETECTION=none
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:19099
FIRESTORE_EMULATOR_HOST=127.0.0.1:18080
FIREBASE_TRUSTED_ADMIN_UIDS=trusted-admin-stage1
APP_URL=http://localhost:3000

# Optional services are disabled/unconfigured by default.
KNOBLY_ENABLE_EMAIL=false
ZOHO_SMTP_EMAIL=
ZOHO_SMTP_PASSWORD=
GROQ_API_KEY=
GROQ_API_KEY_ALT=
SARVAM_API_KEY=
SARVAM_API_KEY_ALT=
GNEWS_API_KEY=

# Only for a separate project you own; never required for the local demo.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Hosted AI endpoints fail closed until a supported shared limiter is configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_RATE_LIMIT_SECRET=
